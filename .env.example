# Copy this file to .env and fill in your values. Never commit .env.
# Get a bot token from Telegram's @BotFather (/newbot).

BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Secret used to sign callback payloads (any long random string).
# If empty, one is generated automatically on first run and saved to .env.
HMAC_SECRET=

# Telegram user IDs allowed to use /admin (comma separated).
# Leave empty to use the default locked admin ID.
# Get your ID from @userinfobot on Telegram.
ADMIN_IDS=

DB_PATH=data/bot.db

# Support contact shown in the Support menu (without @).
SUPPORT_USERNAME=subsmartbd

# --- Supplier API server (api.py) ---
# Run: uvicorn api:app --host 0.0.0.0 --port 8000
API_HOST=0.0.0.0
API_PORT=8000
